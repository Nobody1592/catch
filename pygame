import pygame 
win_h = 500
win_w = 700
sptire_W = 60
sptire_H = 70
window = pygame.display.set_mode((win_w,win_h))
pygame.display.set_caption("Смерть")
backround = pygame.transform.scale(pygame.image.load("background.png"),(win_w,win_h))
clock = pygame.time.Clock()
sptire_1 = pygame.transform.scale(pygame.image.load("sprite1.png"),(sptire_W,sptire_H))
sptire_2 = pygame.transform.scale(pygame.image.load("sprite2.png"),(sptire_H,sptire_H))
x2 = 150
y2 = 80
x1 = 90
y1 = 80
speed = 10

game = True 
while game:
    for event in pygame.event.get():
        if event.type == pygame.QUIT:
            game = False
    window.blit(backround, (0,0))
    window.blit(sptire_1, (x1,y1))
    window.blit(sptire_2, (x2, y2))

    keys = pygame.key.get_pressed()
    if keys [pygame.K_w] and y1 > 0:
        y1 -= speed

    if keys [pygame.K_s] and y1 < win_h - sptire_H:
        y1 += speed

    if keys [pygame.K_d] and x1 < win_w - sptire_W:
        x1 += speed

    if keys [pygame.K_a] and x1 > 0:
        x1 -= speed

    if keys[pygame.K_UP] and y2 > 0:
        y2 -= speed

    if keys[pygame.K_DOWN] and y2 < win_h - sptire_H:
        y2 += speed

    if keys[pygame.K_LEFT] and x2 > 0:
        x2 -= speed

    if keys[pygame.K_RIGHT] and x2 < win_w - sptire_W:
        x2 += speed


    

    pygame.display.update()
    clock.tick(60)


